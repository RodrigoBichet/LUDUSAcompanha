{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludus-acompanha.ufpel.br/schema/ludus-observa-batch-1.0.0.schema.json",
  "title": "Lote observacional do LUDUS Observa",
  "description": "Envelope de transporte de sessões observacionais independentes produzidas pelo LUDUS Observa.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batchSchemaVersion",
    "batchType",
    "source",
    "sourceVersion",
    "batchId",
    "collectionRef",
    "createdAt",
    "participant",
    "sessions"
  ],
  "properties": {
    "batchSchemaVersion": { "const": "1.0.0" },
    "batchType": { "const": "ludus-observa-batch" },
    "source": { "const": "ludus-observa-webextension" },
    "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 50 },
    "batchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "collectionRef": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participantRef",
        "displayName",
        "resolutionStatus",
        "requiresReview"
      ],
      "properties": {
        "participantRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "resolutionStatus": { "const": "local-pending" },
        "requiresReview": { "const": true }
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "object" }
    }
  }
}
